# PrintEase environment template (committed reference — no real secrets)
#
# Copy this file to `.env` and fill in real values.
# For local dev use APP_ENV=local and BASE_URL=http://localhost/printease/
# For production use APP_ENV=production and BASE_URL=https://printease.org/
# `.env` is gitignored — never commit real credentials.

APP_NAME=PrintEase
APP_ENV=production

# Full HTTPS URL of the deployed app, with a trailing slash.
BASE_URL=https://printease.org/

# Database created in cPanel (see docs/DEPLOYMENT_CHECKLIST.md step 3).
DB_HOST=localhost
DB_USER=printease_user
DB_PASS=replace_with_strong_password
DB_NAME=printease_db

# Tesseract OCR binary. 'tesseract' uses PATH; or give an absolute path.
# Optional: if unavailable, GCash payment-reference OCR degrades gracefully
# and reference numbers are entered manually.
TESSERACT_PATH=tesseract

# Google Cloud Vision API key for receipt OCR (optional).
# If Tesseract is unavailable, this key is used as fallback for GCash reference detection.
# Create one at: console.cloud.google.com → APIs & Services → Credentials → Create Credentials → API Key
GOOGLE_CLOUD_VISION_API_KEY=

# Google OAuth. In Google Cloud Console, the Web client must list this exact
# authorized redirect URI (with the deployed domain):
#   https://printease.org/backend/oauth/oauth_callback.php?provider=google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Gmail SMTP (smtp.gmail.com:587, TLS). Use an app password, not the account password.
MAIL_USER=printease122@gmail.com
MAIL_PASS=replace_with_gmail_app_password

# z.com shared hosting SMTP (cPanel Exim server).
# Gmail SMTP is blocked by z.com — use the hosting server's SMTP instead.
# Find your SMTP host in cPanel → Email Accounts → your account → Configure Mail Client.
SMTP_HOST=cpanel11wh.jpt1.cloud.z.com
SMTP_USER=your_cpanel_username
SMTP_PASS=your_cpanel_password

# Cloudinary.
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Optional. If unset or unreachable, sessions fall back to file-based storage.
# Shared hosting generally has no Redis — leave unset.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Server-side session window in days (sliding; refreshed on every request).
# Also drives the session cookie lifetime. Default: 30.
#SESSION_LIFETIME_DAYS=30
